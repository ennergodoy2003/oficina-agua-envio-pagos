# Copiar a .env y ajustar valores.

# RabbitMQ (HU-42)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=cambiar_usuario
RABBITMQ_PASSWORD=cambiar_password

# BD de pagos del monolito
# El producer la lee con un usuario de solo lectura y la Lambda toma de aqui el nombre de la base.
PAGOS_DB_HOST=localhost
PAGOS_DB_PORT=3306
PAGOS_DB_NAME=proyecto_agua
PAGOS_DB_USER=pagos_ro
PAGOS_DB_PASSWORD=cambiar_password

# API del banco (HU-44)
# En local se usa el banco falso (WireMock del docker-compose).
# Para HU-61, cambiar por la URL y la key del simulador del ingeniero.
BANCO_URL=http://localhost:8089
BANCO_API_KEY=cambiar_api_key
BANCO_TEAM_CODE=EQUIPO_A
BANCO_FALSO_PORT=8089

# DynamoDB Local para los logs de envio (HU-46)
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_PORT=8000
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE=pagos-envio-logs

# API del ERP (HU-45)
# En local se usa el ERP falso (WireMock del docker-compose).
# Para HU-61, cambiar por la URL y la key del simulador del ingeniero.
ERP_URL=http://localhost:8090
ERP_API_KEY=cambiar_api_key
ERP_EQUIPO=EQUIPO_A
ERP_FALSO_PORT=8090

# Lambda HU-49 (usuario con INSERT solo en pagos_envio)
LAMBDA_DB_HOST=host.docker.internal
LAMBDA_DB_USER=lambda_flags
LAMBDA_DB_PASSWORD=cambiar_password

# HU-61: escenario del simulador del docente.
# Vacio = AUTO (sin header). Valores: SUCCESS, SLOW, TIMEOUT, LOST_ACK, ERROR_500, ERROR_503, RATE_LIMIT
SIMULACION_ESCENARIO=